# --- SynkAfrica frontend (Next.js) environment ---
# Copy to .env and fill in. Values marked (required) are needed for the app to
# run; the rest enable optional features.

# Base URL of the NestJS backend, including the /api prefix. (required)
NEXT_PUBLIC_API_URL=http://localhost:4001/api

# next-auth v5 session-encryption secret. (required)
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical URL of THIS frontend. (optional — usually leave UNSET)
# auth.ts sets `trustHost: true`, so on Vercel/behind a proxy next-auth derives
# the origin from the forwarded Host header and AUTH_URL is not needed. If you
# DO set AUTH_URL (or the legacy NEXTAUTH_URL), it must be the exact public
# origin of this deployment (scheme + host, no trailing path): next-auth builds
# its absolute URLs (OAuth callbacks, signIn/signOut redirects) from it, and a
# stale value such as http://localhost:3000 sends users to an unreachable host.
# Sign-out itself no longer depends on it (lib/auth/actions.ts redirects to a
# relative path), but OAuth sign-in still does.
# AUTH_URL=https://app.synkafrica.com

# --- Social sign-in (optional) ---
# Google sign-in stays hidden/non-functional until BOTH are set.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Apple sign-in stays non-functional until BOTH are set. AUTH_APPLE_SECRET is
# the signed client-secret JWT generated from your Apple private key / key id /
# team id / service id (see Apple "Sign in with Apple" setup).
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=

# NOTE: social sign-in also needs a backend bridge that exchanges the OAuth
# identity for a backend session (access/refresh tokens). The Credentials
# (OTP / vendor / admin) flows produce those today; a Google/Apple identity
# does not yet. Wiring that bridge is a follow-up beyond supplying credentials.

# --- Address autocomplete (optional) ---
# Server-side only (read by app/api/places). Without it, address suggestions
# come from OpenStreetMap/Photon (no key, but thin street-level coverage in
# parts of Africa). With it, suggestions use Google Places Autocomplete (New)
# and fall back to Photon on error. Enable "Places API (New)" for the key.
# GOOGLE_PLACES_API_KEY=
